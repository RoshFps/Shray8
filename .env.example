# Created for you by scripts/init-env.sh (it fills in the secrets). Never commit .env.

# --- Secrets (init-env.sh generates these) ---------------------------------
# Collectors must send this token to the backend. At least 24 random characters.
AGENT_TOKEN=
# Dashboard login (HTTP basic auth). The password is stored as a bcrypt hash;
# keep the single quotes, the hash contains "$" characters.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH=''

# --- Where and how it is served --------------------------------------------
# Name the dashboard is reached by. "localhost" for this machine only, or a LAN
# hostname/IP, or a public domain.
SITE_ADDRESS=localhost
# "internal" = Caddy's private CA (browser warns until you trust it).
# Public domain with ports 80/443 reachable: set to your email for Let's Encrypt.
TLS_MODE=internal
# Interface to listen on. 0.0.0.0 = whole network, 127.0.0.1 = this machine only.
BIND_ADDRESS=0.0.0.0

# --- Optional ---------------------------------------------------------------
# Comma-separated package names that never count as "unauthorized".
SOFTWARE_ALLOWLIST=
# Days to keep suspicious-process events.
RETENTION_DAYS=30
# true loads the made-up sample company (demo only).
SAMPLE_DATA=false
# true serves the interactive API docs at /docs (behind the login).
ENABLE_DOCS=false
